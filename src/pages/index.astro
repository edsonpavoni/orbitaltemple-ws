---
// Root page: Redirects to language-specific version
// Uses client-side detection since we're in static build mode
import { LANGUAGE_CODES } from "../lib/i18n-config";

// Create a set for faster lookup in client-side script
const supportedLangs = JSON.stringify(LANGUAGE_CODES);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orbital Temple</title>
  <meta name="description" content="Orbital Temple is a satellite with an artistic mission: a memorial in outer space open to every sentient being who lives or has lived on Earth." />

  <!-- Detect language and redirect -->
  <script is:inline define:vars={{ supportedLangs }}>
    (function() {
      const langs = JSON.parse(supportedLangs);
      const langsSet = new Set(langs);

      // Check for legacy ?lg= parameter first
      const urlParams = new URLSearchParams(window.location.search);
      const lgParam = urlParams.get('lg');
      if (lgParam && langsSet.has(lgParam)) {
        window.location.replace('/' + lgParam + '/');
        return;
      }

      // Check localStorage for previous language preference
      const storedLang = localStorage.getItem('i18nextLng');
      if (storedLang && langsSet.has(storedLang)) {
        window.location.replace('/' + storedLang + '/');
        return;
      }

      // Detect from browser language
      const browserLangs = navigator.languages || [navigator.language];
      let targetLang = 'en'; // default

      for (const browserLang of browserLangs) {
        const lang = browserLang.toLowerCase();
        // Try exact match
        if (langsSet.has(lang)) {
          targetLang = lang;
          break;
        }
        // Try base language (e.g., "pt-BR" -> "pt")
        const baseLang = lang.split('-')[0];
        if (langsSet.has(baseLang)) {
          targetLang = baseLang;
          break;
        }
      }

      window.location.replace('/' + targetLang + '/');
    })();
  </script>

  <!-- Fallback for no-JS: redirect to English -->
  <noscript>
    <meta http-equiv="refresh" content="0;url=/en/" />
  </noscript>
</head>
<body style="margin: 0; padding: 0; min-height: 100vh; background-color: #1a1a1a; display: flex; align-items: center; justify-content: center;">
  <p style="color: #FAD43A; font-family: sans-serif;">Redirecting...</p>
</body>
</html>
