---
import Base from "../layouts/BaseLayout.astro";
---
<Base title="Countdown Variations">
  <div style="background: var(--color-ot-dark); min-height: 100vh; padding: 2rem;">
    <h1 style="color: white; text-align: center; margin-bottom: 3rem;">Countdown Variations with Prefix</h1>

    <!-- Variation A -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">A) "Launches in" - Inline</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-a"></div>
      </div>
    </section>

    <!-- Variation B -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">B) "Launches in" - Stacked</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-b"></div>
      </div>
    </section>

    <!-- Variation C -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">C) "The Orbital Temple launches into space in"</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-c"></div>
      </div>
    </section>

    <!-- Variation D -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">D) "Launching in" - Gold numbers</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-d"></div>
      </div>
    </section>

    <!-- Variation E -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">E) "Ascends to orbit in" - Poetic</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-e"></div>
      </div>
    </section>

    <!-- Variation F -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">F) "T-minus" - Mission style</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-f"></div>
      </div>
    </section>

    <!-- Variation G -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">G) "Liftoff in" - Compact inline</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-g"></div>
      </div>
    </section>

    <!-- Variation H -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">H) "Journey begins in" - Elegant</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-h"></div>
      </div>
    </section>

    <!-- Variation I -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">I) Days only - Bold statement</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-i"></div>
      </div>
    </section>

    <!-- Variation J -->
    <section style="margin-bottom: 4rem; padding: 2rem; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;">
      <h2 style="color: var(--color-ot-gold200); margin-bottom: 1rem;">J) "Reaches the stars in" - Dreamy</h2>
      <div style="text-align: center; color: white;">
        <p style="opacity: 0.8; margin-bottom: 1rem;">A purely artistic satellite from the Global South,<br/>carrying the names of those we love<br/>to a place where no wall can reach.</p>
        <div id="countdown-j"></div>
      </div>
    </section>

  </div>

  <script>
    const launchDate = new Date('2025-12-25T04:15:00Z');

    function getTimeLeft() {
      const now = new Date();
      const diff = launchDate.getTime() - now.getTime();
      if (diff <= 0) return { days: 0, hours: 0, minutes: 0, seconds: 0 };
      return {
        days: Math.floor(diff / (1000 * 60 * 60 * 24)),
        hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
        minutes: Math.floor((diff / 1000 / 60) % 60),
        seconds: Math.floor((diff / 1000) % 60),
      };
    }

    const pad = (n) => String(n).padStart(2, '0');

    function renderCountdowns() {
      const t = getTimeLeft();

      // A) "Launches in" - Inline
      document.getElementById('countdown-a').innerHTML = `
        <div style="margin-top: 1.5rem; display: flex; align-items: baseline; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
          <span style="font-size: 14px; opacity: 0.7; font-style: italic;">Launches in</span>
          <span style="font-size: 24px; font-weight: 600; letter-spacing: 0.02em;">${t.days}d ${pad(t.hours)}h ${pad(t.minutes)}m ${pad(t.seconds)}s</span>
        </div>
      `;

      // B) "Launches in" - Stacked
      document.getElementById('countdown-b').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 13px; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.75rem;">Launches in</div>
          <div style="display: flex; gap: 1.5rem; justify-content: center; align-items: center;">
            ${[{v: t.days, l: 'days'}, {v: t.hours, l: 'hrs'}, {v: t.minutes, l: 'min'}, {v: t.seconds, l: 'sec'}].map(({v, l}) => `
              <div style="text-align: center;">
                <div style="font-size: 32px; font-weight: 700; line-height: 1; color: #fff;">${pad(v)}</div>
                <div style="font-size: 10px; font-weight: 400; color: #fff; opacity: 0.5; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px;">${l}</div>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      // C) "The Orbital Temple launches into space in"
      document.getElementById('countdown-c').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 14px; opacity: 0.7; margin-bottom: 0.75rem; font-style: italic;">The Orbital Temple launches into space in</div>
          <div style="font-size: 28px; font-weight: 600; letter-spacing: 0.05em;">
            ${t.days} days, ${t.hours}h ${pad(t.minutes)}m ${pad(t.seconds)}s
          </div>
        </div>
      `;

      // D) "Launching in" - Gold numbers
      document.getElementById('countdown-d').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 12px; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 0.75rem;">Launching in</div>
          <div style="display: flex; gap: 1.25rem; justify-content: center; align-items: center;">
            ${[{v: t.days, l: 'd'}, {v: t.hours, l: 'h'}, {v: t.minutes, l: 'm'}, {v: t.seconds, l: 's'}].map(({v, l}) => `
              <div style="text-align: center;">
                <span style="font-size: 36px; font-weight: 700; color: #C9A227;">${pad(v)}</span><span style="font-size: 14px; opacity: 0.5; margin-left: 2px;">${l}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      // E) "Ascends to orbit in" - Poetic
      document.getElementById('countdown-e').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 15px; opacity: 0.8; margin-bottom: 1rem; font-style: italic; letter-spacing: 0.02em;">Ascends to orbit in</div>
          <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: baseline;">
            <span style="font-size: 48px; font-weight: 300; color: #fff;">${t.days}</span>
            <span style="font-size: 16px; opacity: 0.6;">days</span>
            <span style="font-size: 32px; font-weight: 300; color: #fff; margin-left: 0.5rem;">${pad(t.hours)}</span>
            <span style="font-size: 14px; opacity: 0.5;">h</span>
            <span style="font-size: 32px; font-weight: 300; color: #fff;">${pad(t.minutes)}</span>
            <span style="font-size: 14px; opacity: 0.5;">m</span>
            <span style="font-size: 32px; font-weight: 300; color: #fff;">${pad(t.seconds)}</span>
            <span style="font-size: 14px; opacity: 0.5;">s</span>
          </div>
        </div>
      `;

      // F) "T-minus" - Mission style
      document.getElementById('countdown-f').innerHTML = `
        <div style="margin-top: 1.5rem; font-family: monospace;">
          <span style="font-size: 14px; opacity: 0.7; letter-spacing: 0.1em;">T-</span>
          <span style="font-size: 32px; font-weight: 700; letter-spacing: 0.05em;">${pad(t.days)}:${pad(t.hours)}:${pad(t.minutes)}:${pad(t.seconds)}</span>
        </div>
      `;

      // G) "Liftoff in" - Compact inline
      document.getElementById('countdown-g').innerHTML = `
        <div style="margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.75rem; background: rgba(255,255,255,0.05); padding: 0.75rem 1.5rem; border-radius: 100px; border: 1px solid rgba(255,255,255,0.1);">
          <span style="font-size: 12px; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.1em;">Liftoff in</span>
          <span style="font-size: 20px; font-weight: 600;">${t.days}d ${pad(t.hours)}:${pad(t.minutes)}:${pad(t.seconds)}</span>
        </div>
      `;

      // H) "Journey begins in" - Elegant
      document.getElementById('countdown-h').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 14px; opacity: 0.7; font-style: italic; margin-bottom: 1rem;">The journey begins in</div>
          <div style="display: flex; gap: 2rem; justify-content: center; align-items: center;">
            ${[{v: t.days, l: 'days'}, {v: t.hours, l: 'hours'}, {v: t.minutes, l: 'minutes'}].map(({v, l}) => `
              <div style="text-align: center;">
                <div style="font-size: 40px; font-weight: 300; line-height: 1; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 8px; margin-bottom: 8px;">${pad(v)}</div>
                <div style="font-size: 11px; font-weight: 400; color: #fff; opacity: 0.5; text-transform: lowercase; letter-spacing: 0.1em;">${l}</div>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      // I) Days only - Bold statement
      document.getElementById('countdown-i').innerHTML = `
        <div style="margin-top: 1.5rem; display: flex; align-items: baseline; justify-content: center; gap: 0.5rem;">
          <span style="font-size: 64px; font-weight: 700; line-height: 1; color: #C9A227;">${t.days}</span>
          <span style="font-size: 18px; opacity: 0.7;">days until launch</span>
        </div>
      `;

      // J) "Reaches the stars in" - Dreamy
      document.getElementById('countdown-j').innerHTML = `
        <div style="margin-top: 1.5rem;">
          <div style="font-size: 13px; opacity: 0.6; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.5rem;">Reaches the stars in</div>
          <div style="font-size: 20px; font-weight: 400; opacity: 0.9; letter-spacing: 0.05em;">
            ${t.days} days · ${t.hours} hours · ${t.minutes} minutes
          </div>
        </div>
      `;
    }

    renderCountdowns();
    setInterval(renderCountdowns, 1000);
  </script>
</Base>
