---
import Base from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import UpdatesContent from "../../components/UpdatesContent";
import { LANGUAGE_CODES, isValidLanguage } from "../../lib/i18n-config";

export function getStaticPaths() {
  return LANGUAGE_CODES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;

if (!isValidLanguage(lang)) {
  return Astro.redirect('/en/updates', 302);
}

const lgParam = Astro.url.searchParams.get('lg');
if (lgParam && lgParam !== lang && isValidLanguage(lgParam)) {
  return Astro.redirect(`/${lgParam}/updates`, 301);
}
---
<Base lang={lang}>

  <main class="artwork-page">
    <UpdatesContent client:only="react" />

    <!-- Footer -->
    <footer class="artwork-footer">
      <Footer />
    </footer>

  </main>

  <style is:global>
    .update-article {
      max-width: 700px;
    }

    .update-content p {
      margin-bottom: 1.5rem;
    }

    .update-content em {
      display: block;
      margin: 2rem 0;
      font-style: italic;
    }
  </style>

  <script define:vars={{ lang }}>
    if (typeof window !== 'undefined') {
      localStorage.setItem('i18nextLng', lang);
    }
  </script>

</Base>
