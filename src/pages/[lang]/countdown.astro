---
import CountdownLayout from "../../layouts/CountdownLayout.astro";
import CountdownTimer from "../../components/CountdownTimer";
import { LANGUAGE_CODES, isValidLanguage } from "../../lib/i18n-config";

export function getStaticPaths() {
  return LANGUAGE_CODES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;

if (!isValidLanguage(lang)) {
  return Astro.redirect('/en/countdown', 302);
}

const lgParam = Astro.url.searchParams.get('lg');
if (lgParam && lgParam !== lang && isValidLanguage(lgParam)) {
  return Astro.redirect(`/${lgParam}/countdown`, 301);
}
---

<CountdownLayout lang={lang}>

  <!-- Full Screen Countdown Section -->
  <section style="position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem;">

    <!-- Satellite Background Video -->
    <div style="position: absolute; inset: 0; z-index: 0;">
      <!-- Mobile Video -->
      <video
        autoplay
        loop
        muted
        playsinline
        poster="/videos/mobile_placeholder.webp"
        style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; display: block;"
        class="mobile-video">
        <source src="/videos/mobile.webm" type="video/webm" />
        <source src="/videos/mobile_h264.mp4" type="video/mp4" />
      </video>

      <!-- Desktop Video -->
      <video
        autoplay
        loop
        muted
        playsinline
        poster="/videos/desk_placeholder.webp"
        style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; display: none;"
        class="desktop-video">
        <source src="/videos/desk_h264.webm" type="video/webm" />
        <source src="/videos/desk_h264.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Content -->
    <div style="position: relative; z-index: 1; text-align: center; max-width: 800px;">

      <!-- Countdown Timer - TEMPORARILY HIDDEN pending new launch date -->
      <!-- <div style="margin-bottom: 3rem;">
        <CountdownTimer client:only="react" />
      </div>

      <p style="font-size: 16px; line-height: 1.5; color: #ffffff; opacity: 0.9; margin-bottom: 2rem; font-weight: 400;">
        to launch of the Orbital Temple
      </p> -->

      <!-- Mission Status -->
      <div style="margin-bottom: 3rem; text-align: center;">
        <div style="font-size: 18px; font-weight: 400; color: #ffffff; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
          Mission Update
        </div>
        <div style="font-size: 24px; font-weight: 500; color: #ffffff; line-height: 1.4;">
          New launch date to be announced
        </div>
      </div>

      <!-- Main Title -->
      <h1 style="font-size: 28px; line-height: 1.3; font-weight: 700; color: #ffffff; margin-bottom: 2rem;">
        Orbital Temple
      </h1>

      <!-- Description -->
      <p style="font-size: 16px; line-height: 1.6; color: #ffffff; opacity: 0.8; max-width: 600px; margin: 0 auto;">
        is an artwork and a satellite,<br>
        aiming to be a radical inclusive temple,<br>
        in a place where no wall can reach.
      </p>

    </div>

  </section>

  <!-- Media Query for Desktop Video -->
  <style is:global>
    @media (min-width: 768px) {
      .mobile-video {
        display: none !important;
      }
      .desktop-video {
        display: block !important;
      }
    }
  </style>

  <script define:vars={{ lang }}>
    if (typeof window !== 'undefined') {
      localStorage.setItem('i18nextLng', lang);
    }
  </script>

</CountdownLayout>
