{
  "rules": {
    ".read": false,
    ".write": false,

    "sculpture": {
      ".read": true,
      ".write": false,

      "angle": {
        ".validate": "newData.hasChildren(['angle', 'timestamp'])",
        "angle": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },

      "commands": {
        "$field": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
        }
      }
    }
  }
}
